PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocko
FRONTEND_URL=http://localhost:5003
# GitHub App: `bun run setup:github --api <URL pública da API>` cria o App e preenche este bloco.
# Manual: Callback URL <api>/auth/github/callback; Setup URL <api>/auth/github/login com "Redirect on update";
# permissões Contents e Metadata (read); webhook <api>/webhooks/github com evento Push.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# .pem do App; pode ter \n escapado
GITHUB_APP_PRIVATE_KEY=
# Vazio = sem webhook: repos só atualizam pelo sync manual
GITHUB_WEBHOOK_SECRET=
# Opcional: só estes logins do GitHub (separados por vírgula) criam workspaces. Vazio = qualquer conta. Todos podem entrar por convite.
ALLOWED_GITHUB_LOGINS=
# OpenRouter → openrouter.ai/keys. LLM_MODEL = slug do OpenRouter (evite `:free` com código de clientes)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Teto de gasto em USD por workspace nas últimas 24h (custo do OpenRouter)
MAX_DAILY_COST_USD=5
# Tokens de contexto que disparam o resumo dos turnos antigos da conversa (~60% da janela do modelo)
CONTEXT_SUMMARY_TOKENS=100000
# Mangaba Router (OpenAI-compatível). A chave mr-... é configurada por workspace em Configurações (precisa de SECRETS_KEY)
# MANGABA_BASE_URL=https://mangabarouter.store/v1
# grep do agente: git (padrão) ou zoekt (índice de trigramas; binários só na imagem Docker, sem eles cai no git)
GREP_BACKEND=git
# Criptografa headers de auth das APIs do projeto: openssl rand -base64 32
SECRETS_KEY=
